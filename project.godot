; Engine configuration file.

config_version=5

[application]

config/name="Launcher"
config/description="Installe, met à jour et lance les jeux de Keizuka."
config/version="0.6.0"
run/main_scene="res://scenes/launcher.tscn"
config/icon="res://assets/images/icone.png"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

